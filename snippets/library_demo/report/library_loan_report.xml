<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_library_loan" model="ir.actions.report">
        <field name="name">Loan Slip</field>
        <field name="model">library.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_demo.report_library_loan_document</field>
        <field name="report_file">library_demo.report_library_loan_document</field>
        <field name="print_report_name">'Loan - %s' % object.name</field>
        <field name="binding_model_id" ref="model_library_loan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_library_loan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Loan <span t-field="o.name"/></h2>
                        <table class="table table-sm">
                            <tr><th>Borrower</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Book</th><td><span t-field="o.book_id.name"/></td></tr>
                            <tr><th>Due</th><td><span t-field="o.date_due"/></td></tr>
                        </table>
                        <p t-if="o.days_overdue">
                            Overdue by <t t-out="o.days_overdue"/> days.
                            Fine: <t t-out="o.fine" t-options="{'widget': 'float', 'precision': 2}"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting a core view: smart button, new field, attributes change, new page, hide something -->
    <record id="view_partner_form_gallery" model="ir.ui.view">
        <field name="name">res.partner.form.gallery</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- 1. smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gallery" type="object" class="oe_stat_button" icon="fa-th">
                    <field name="gallery_count" widget="statinfo" string="Gallery"/>
                </button>
            </xpath>
            <!-- 2. field after another field -->
            <field name="website" position="after">
                <field name="gallery_note"/>
            </field>
            <!-- 3. change attributes of an existing field -->
            <field name="email" position="attributes">
                <attribute name="required">is_company</attribute>
            </field>
            <!-- 4. new notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Gallery" name="gallery_page">
                    <group><field name="gallery_note"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
